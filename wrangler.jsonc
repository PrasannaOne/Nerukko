{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neruko",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Matchmaker"] }
  ]
}
